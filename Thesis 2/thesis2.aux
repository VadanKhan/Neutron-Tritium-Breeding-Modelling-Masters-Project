\newlabel{sub@fig:1d_benchmark}{{a}{10}{1D multi-modal Schwefel function test}{figure.caption.4}{}}
\newlabel{fig:2d_gramacy_lee}{{4b}{10}{2D Gramacy \& Lee function test}{figure.caption.4}{}}
\newlabel{sub@fig:2d_gramacy_lee}{{b}{10}{2D Gramacy \& Lee function test}{figure.caption.4}{}}
\newlabel{fig:2d_hidden_peak}{{4c}{10}{2D Hidden Peak function test}{figure.caption.4}{}}
\newlabel{sub@fig:2d_hidden_peak}{{c}{10}{2D Hidden Peak function test}{figure.caption.4}{}}
\newlabel{fig:2d_schwefel}{{4d}{10}{2D multi-modal Schwefel function test}{figure.caption.4}{}}
\newlabel{sub@fig:2d_schwefel}{{d}{10}{2D multi-modal Schwefel function test}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Benchmarking of the ML optimisation algorithm across challenging mathematical landscapes. (a) A 1D Schwefel test case illustrating full surrogate model reconstruction (model uncertainty is plotted but too small to be visible). (b) 2D Gramacy \& Lee function test illustrating global trend reconstruction but localised peak ignorance. (c) 2D Hidden Peak function test successfully escaping and finding the true peak. (d) 2D multi-modal Schwefel function test demonstrating complete reconstruction of the detailed space. Pink markers annotate where a secondary ``peak hunt'' is triggered. Trials ($N$): (a, b, d) used $N=150$, while (c) used $N=100$. All tests utilised $N_{sobol}=50$ and UCB $\beta =1,000,000$. Bespoke algorithm enhancements were not enabled for (a) and (b). Enhancements in (c) and (d) used $\epsilon = 0.75$, and $n_{hunt}=10$.}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:ml_benchmarks_main}{{4}{10}{Benchmarking of the ML optimisation algorithm across challenging mathematical landscapes. (a) A 1D Schwefel test case illustrating full surrogate model reconstruction (model uncertainty is plotted but too small to be visible). (b) 2D Gramacy \& Lee function test illustrating global trend reconstruction but localised peak ignorance. (c) 2D Hidden Peak function test successfully escaping and finding the true peak. (d) 2D multi-modal Schwefel function test demonstrating complete reconstruction of the detailed space. Pink markers annotate where a secondary ``peak hunt'' is triggered. Trials ($N$): (a, b, d) used $N=150$, while (c) used $N=100$. All tests utilised $N_{sobol}=50$ and UCB $\beta =1,000,000$. Bespoke algorithm enhancements were not enabled for (a) and (b). Enhancements in (c) and (d) used $\epsilon = 0.75$, and $n_{hunt}=10$}{figure.caption.4}{}}

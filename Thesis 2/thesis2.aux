\newlabel{fig:1d_benchmark}{{3a}{6}{1D multi-modal Schwefel function test}{figure.caption.3}{}}
\newlabel{sub@fig:1d_benchmark}{{a}{6}{1D multi-modal Schwefel function test}{figure.caption.3}{}}
\newlabel{fig:2d_gramacy_lee}{{3b}{6}{2D Gramacy \& Lee function test}{figure.caption.3}{}}
\newlabel{sub@fig:2d_gramacy_lee}{{b}{6}{2D Gramacy \& Lee function test}{figure.caption.3}{}}
\newlabel{fig:2d_hidden_peak}{{3c}{6}{2D Hidden Peak function test}{figure.caption.3}{}}
\newlabel{sub@fig:2d_hidden_peak}{{c}{6}{2D Hidden Peak function test}{figure.caption.3}{}}
\newlabel{fig:2d_schwefel}{{3d}{6}{2D multi-modal Schwefel function test}{figure.caption.3}{}}
\newlabel{sub@fig:2d_schwefel}{{d}{6}{2D multi-modal Schwefel function test}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Comprehensive benchmarking of the ML optimisation algorithm across multiple challenging landscapes. (a) A 1D Schwefel test case illustrating full surrogate model reconstruction against the true function. The uncertainty in the model is plotted but too small to be visible. (b), (c) and (d) demonstrate various 2D function tests of the optimiser, where the final mean surrogate model of the space and its paired standard deviation is plotted underneath each. (a) and (b) used $N=100$ trials whereas (c) and (d) used $N=150$, where this includes $N_{sobol}=50$ sobol trials for all. $\beta =1,000,000$ was consistent across all trials. Random injection and multi-modal exploitation was implemented for (c) and (d) with $\epsilon = 0.75$ and $n_{hunt}=10$. (d) includes pink markers to annotate where a secondary ``peak hunt'' is triggered.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:ml_benchmarks_4panel}{{3}{6}{Comprehensive benchmarking of the ML optimisation algorithm across multiple challenging landscapes. (a) A 1D Schwefel test case illustrating full surrogate model reconstruction against the true function. The uncertainty in the model is plotted but too small to be visible. (b), (c) and (d) demonstrate various 2D function tests of the optimiser, where the final mean surrogate model of the space and its paired standard deviation is plotted underneath each. (a) and (b) used $N=100$ trials whereas (c) and (d) used $N=150$, where this includes $N_{sobol}=50$ sobol trials for all. $\beta =1,000,000$ was consistent across all trials. Random injection and multi-modal exploitation was implemented for (c) and (d) with $\epsilon = 0.75$ and $n_{hunt}=10$. (d) includes pink markers to annotate where a secondary ``peak hunt'' is triggered}{figure.caption.3}{}}
\newlabel{fig:tbr_comparison}{{4a}{7}{TBR comparison across modelling approximations}{figure.caption.4}{}}
\newlabel{sub@fig:tbr_comparison}{{a}{7}{TBR comparison across modelling approximations}{figure.caption.4}{}}
\newlabel{fig:tbr_thickness}{{4b}{7}{Layer-wise TBR contribution vs. thickness}{figure.caption.4}{}}
\newlabel{sub@fig:tbr_thickness}{{b}{7}{Layer-wise TBR contribution vs. thickness}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Evaluating TBR of the layered blanket architecture. (a) Highlights the degradation of global TBR when transitioning from idealised homogeneous mixtures to realistic heterogeneous layers. (b) Demonstrates the spatial distribution of tritium production, showing heavy concentration in the plasma-facing layers as overall blanket depth increases.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:layered_model_neutronics}{{4}{7}{Evaluating TBR of the layered blanket architecture. (a) Highlights the degradation of global TBR when transitioning from idealised homogeneous mixtures to realistic heterogeneous layers. (b) Demonstrates the spatial distribution of tritium production, showing heavy concentration in the plasma-facing layers as overall blanket depth increases}{figure.caption.4}{}}

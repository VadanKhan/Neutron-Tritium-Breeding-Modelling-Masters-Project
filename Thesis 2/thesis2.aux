\newlabel{sub@fig:ucb_low_beta}{{b}{5}{Greedy tuning ($\beta = 1$)}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Comparison of the Upper Confidence Bound (UCB) acquisition function behaviour under different exploration parameters ($\beta $). (a) A high $\beta $ value successfully prioritises exploration, identifying a secondary hidden peak. (b) A low $\beta $ value results in overly greedy exploitation, causing the model to stagnate on a single local optimum and ignore unexplored regions.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:ucb_tuning}{{2}{5}{Comparison of the Upper Confidence Bound (UCB) acquisition function behaviour under different exploration parameters ($\beta $). (a) A high $\beta $ value successfully prioritises exploration, identifying a secondary hidden peak. (b) A low $\beta $ value results in overly greedy exploitation, causing the model to stagnate on a single local optimum and ignore unexplored regions}{figure.caption.2}{}}

\newlabel{fig:2d_gramacy_lee}{{4b}{12}{2D Gramacy \& Lee function test}{figure.caption.4}{}}
\newlabel{sub@fig:2d_gramacy_lee}{{b}{12}{2D Gramacy \& Lee function test}{figure.caption.4}{}}

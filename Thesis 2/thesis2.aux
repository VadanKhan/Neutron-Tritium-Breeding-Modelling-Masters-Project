\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces  The impact of the linear gradient parameter ($\zeta $) on key neutronic performance metrics. (a) Tracks the total Tritium Breeding Ratio (TBR) and the individual contributions from discrete breeder layers. (b) Illustrates the total neutron multiplication alongside the specific contributions from the first wall, breeder, coolant, and structural separator layers. Statistical uncertainties are plotted, though error bars are generally smaller than the data markers. }}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:zeta_neutronics}{{8}{14}{The impact of the linear gradient parameter ($\zeta $) on key neutronic performance metrics. (a) Tracks the total Tritium Breeding Ratio (TBR) and the individual contributions from discrete breeder layers. (b) Illustrates the total neutron multiplication alongside the specific contributions from the first wall, breeder, coolant, and structural separator layers. Statistical uncertainties are plotted, though error bars are generally smaller than the data markers}{figure.caption.8}{}}
\newlabel{fig:zeta_dpa}{{9a}{14}{DPA rates across components}{figure.caption.9}{}}
\newlabel{sub@fig:zeta_dpa}{{a}{14}{DPA rates across components}{figure.caption.9}{}}
\newlabel{fig:zeta_damage_energy}{{9b}{14}{Damage energy deposition}{figure.caption.9}{}}
\newlabel{sub@fig:zeta_damage_energy}{{b}{14}{Damage energy deposition}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces  The impact of the linear gradient parameter ($\zeta $) on structural degradation metrics. Figure \ref {fig:zeta_dpa} tracks the Displacements Per Atom (DPA), while Figure \ref {fig:zeta_damage_energy} tracks the damage energy deposited into the first wall and internal structural separators. Statistical uncertainties are plotted, though error bars are generally smaller than the data markers. }}{14}{figure.caption.9}\protected@file@percent }
\newlabel{fig:zeta_structural_damage}{{9}{14}{The impact of the linear gradient parameter ($\zeta $) on structural degradation metrics. Figure \ref {fig:zeta_dpa} tracks the Displacements Per Atom (DPA), while Figure \ref {fig:zeta_damage_energy} tracks the damage energy deposited into the first wall and internal structural separators. Statistical uncertainties are plotted, though error bars are generally smaller than the data markers}{figure.caption.9}{}}
\newlabel{fig:zeta_flux}{{10a}{15}{Volume-integrated flux tally}{figure.caption.10}{}}
\newlabel{sub@fig:zeta_flux}{{a}{15}{Volume-integrated flux tally}{figure.caption.10}{}}
\newlabel{fig:zeta_scatter}{{10b}{15}{Neutron scattering events}{figure.caption.10}{}}
\newlabel{sub@fig:zeta_scatter}{{b}{15}{Neutron scattering events}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces  The effect of the linear gradient parameter ($\zeta $) on neutron transport and interaction metrics. Figure \ref {fig:zeta_flux} plots the volume-integrated flux (total neutron path length in $\text  {n} \cdot \text  {cm}$) across the blanket and its individual components. Figure \ref {fig:zeta_scatter} plots the corresponding number of neutron scattering events. Statistical uncertainties are plotted, though error bars are generally smaller than the data markers. }}{15}{figure.caption.10}\protected@file@percent }
\newlabel{fig:zeta_flux_scatter}{{10}{15}{The effect of the linear gradient parameter ($\zeta $) on neutron transport and interaction metrics. Figure \ref {fig:zeta_flux} plots the volume-integrated flux (total neutron path length in $\text {n} \cdot \text {cm}$) across the blanket and its individual components. Figure \ref {fig:zeta_scatter} plots the corresponding number of neutron scattering events. Statistical uncertainties are plotted, though error bars are generally smaller than the data markers}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces  Radial thickness profiles and resulting global TBR for the ML optimised TBR-thickness studies detailed in section \ref {sec:ml_runs}. Associated TBR values are annotated alongside their standard statistical uncertainty. $N=100$ was used for all except for unconstrained 8D $N=150$, where these include $N_{sobol}=50$. Hyper-parameters $\epsilon =0.5$ and $\beta =1,000,000$ were tuned for these studies. The total runtime for every optimisation was between $1-1.5$hrs, limited by the neutronics code taking 1 minute per iteration, not the ML optimiser.}}{15}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ml_optimisation}{{11}{15}{Radial thickness profiles and resulting global TBR for the ML optimised TBR-thickness studies detailed in section \ref {sec:ml_runs}. Associated TBR values are annotated alongside their standard statistical uncertainty. $N=100$ was used for all except for unconstrained 8D $N=150$, where these include $N_{sobol}=50$. Hyper-parameters $\epsilon =0.5$ and $\beta =1,000,000$ were tuned for these studies. The total runtime for every optimisation was between $1-1.5$hrs, limited by the neutronics code taking 1 minute per iteration, not the ML optimiser}{figure.caption.11}{}}

\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Isotopic and Compositional Optimisation}{18}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Tritium Breeding Ratio (TBR) as a function of \ce {^6Li} enrichment percentage. The curve is characterised by a rapid initial increase which saturates early; the ``knee" of the curve appears at approximately 20\%, with the TBR effectively capping at 40\%. Beyond this saturation point, the returns are diminishing. Notably, a slight suppression in breeding performance is observed at near-total enrichment levels ($>90\%$)}}{18}{figure.caption.7}\protected@file@percent }
\newlabel{fig:enrichment}{{5}{18}{Tritium Breeding Ratio (TBR) as a function of \ce {^6Li} enrichment percentage. The curve is characterised by a rapid initial increase which saturates early; the ``knee" of the curve appears at approximately 20\%, with the TBR effectively capping at 40\%. Beyond this saturation point, the returns are diminishing. Notably, a slight suppression in breeding performance is observed at near-total enrichment levels ($>90\%$)}{figure.caption.7}{}}
\abx@aux@cite{0}{stornelli_ultra-fine_2024}
\abx@aux@segm{0}{0}{stornelli_ultra-fine_2024}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces TBR dependence on Lead fraction in a simplified non-eutectic / constant packing factor $\text  {Li}_{(100-x)}\text  {Pb}_x$ breeder, where the density is calculated as a simple weighted average of \ce {Li} and \ce {Pb}. Breeding performance peaks at approximately 50\% lead concentration, with a rapid decline observed beyond 75\%. The eutectic point is marked for reference, far exceeding any non-eutectic TBR. Error bars are included but are too small to be visible at this scale.}}{19}{figure.caption.8}\protected@file@percent }
\newlabel{fig:multiplier}{{6}{19}{TBR dependence on Lead fraction in a simplified non-eutectic / constant packing factor $\text {Li}_{(100-x)}\text {Pb}_x$ breeder, where the density is calculated as a simple weighted average of \ce {Li} and \ce {Pb}. Breeding performance peaks at approximately 50\% lead concentration, with a rapid decline observed beyond 75\%. The eutectic point is marked for reference, far exceeding any non-eutectic TBR. Error bars are included but are too small to be visible at this scale}{figure.caption.8}{}}

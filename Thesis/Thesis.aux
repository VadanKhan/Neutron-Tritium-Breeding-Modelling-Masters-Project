\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Impact of coolant choice on breeding performance. (a) TBR vs. Coolant Volume Fraction. While gaseous coolants (\ce {He}, \ce {N}) act as voids, \ce {H_2O} acts as a moderator, mitigating the TBR drop-off at high coolant fractions. Error bars are included but are too small to be visible at this scale.(b) Incident Neutron Energy spectrum. The \ce {H_2O} spectrum shows significant thermalization compared to the gaseous coolants, increasing the interaction cross-section. }}{17}{figure.caption.9}\protected@file@percent }
\newlabel{fig:coolants}{{7}{17}{Impact of coolant choice on breeding performance. (a) TBR vs. Coolant Volume Fraction. While gaseous coolants (\ce {He}, \ce {N}) act as voids, \ce {H_2O} acts as a moderator, mitigating the TBR drop-off at high coolant fractions. Error bars are included but are too small to be visible at this scale.(b) Incident Neutron Energy spectrum. The \ce {H_2O} spectrum shows significant thermalization compared to the gaseous coolants, increasing the interaction cross-section}{figure.caption.9}{}}

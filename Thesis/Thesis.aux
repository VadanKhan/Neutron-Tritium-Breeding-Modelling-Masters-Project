\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Neutron cross-sections for the primary tritium breeding reactions, \ce {^{6}Li(n, \alpha )t} and $\ce {^{7}Li(n, \alpha t)n^{\prime }}$, as a function of incident neutron energy. The \ce {^{6}Li} cross-section is dominant at low (thermal) energies, while the \ce {^{7}Li} reaction is a threshold reaction requiring high-energy neutrons.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:lithium_cross_sections}{{2}{5}{Neutron cross-sections for the primary tritium breeding reactions, \ce {^{6}Li(n, \alpha )t} and $\ce {^{7}Li(n, \alpha t)n^{\prime }}$, as a function of incident neutron energy. The \ce {^{6}Li} cross-section is dominant at low (thermal) energies, while the \ce {^{7}Li} reaction is a threshold reaction requiring high-energy neutrons}{figure.caption.2}{}}

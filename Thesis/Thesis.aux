\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces A summary of solid breeder materials, their properties, and simulated TBR (error on each $\leq 0.005$) and simulated average heating per neutron (error on each $\leq 0.05$). Material data was obtained from \blx@tocontentsinit {0}\cite {hernandez_first_2018} and \blx@tocontentsinit {0}\cite {liu_design_2022}, where we applied a packing factor of 62\% on these quoted densities for our simulations to account for actual occupied space.}}{11}{table.caption.6}\protected@file@percent }
\newlabel{tab:solid_breeders}{{2}{11}{A summary of solid breeder materials, their properties, and simulated TBR (error on each $\leq 0.005$) and simulated average heating per neutron (error on each $\leq 0.05$). Material data was obtained from \cite {hernandez_first_2018} and \cite {liu_design_2022}, where we applied a packing factor of 62\% on these quoted densities for our simulations to account for actual occupied space}{table.caption.6}{}}

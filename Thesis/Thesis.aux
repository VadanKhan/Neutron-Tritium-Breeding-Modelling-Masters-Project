\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Sensitivity of TBR to reactor triangularity ($\delta $). The gradient of $0.015 \pm 0.001$ indicates that triangularity has a negligible impact on global neutronics, consistent with the use of a uniform ring source model.}}{18}{figure.caption.10}\protected@file@percent }
\newlabel{fig:triangularity}{{8}{18}{Sensitivity of TBR to reactor triangularity ($\delta $). The gradient of $0.015 \pm 0.001$ indicates that triangularity has a negligible impact on global neutronics, consistent with the use of a uniform ring source model}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces TBR degradation as a function of First Wall (FW) thickness for various candidate materials. Zirconium-based alloys demonstrate the lowest parasitic absorption, maintaining the highest TBR profile. Error bars are included but are too small to be visible at this scale.}}{19}{figure.caption.11}\protected@file@percent }
\newlabel{fig:first_wall}{{9}{19}{TBR degradation as a function of First Wall (FW) thickness for various candidate materials. Zirconium-based alloys demonstrate the lowest parasitic absorption, maintaining the highest TBR profile. Error bars are included but are too small to be visible at this scale}{figure.caption.11}{}}

\newlabel{fig:coolant_fraction}{{7a}{16}{Graph of TBR trends againt Coolant fraction for \ce {He(g)}, \ce {N(g)} and \ce {H_2O(l)}. This is a fraction of coolant per volume in the fusion breeder blanket, homogenously spread throughout the blanket as an approximation of real coolant structures. \ce {He(g)} and \ce {N(g)} have very similar trends, as act similar to replacing breeding material with a vacuum. \ce {H_2O(l)} has an interesting trend, in which TBR seems to decrease at a much slower rate against coolant fraction. This indicates that having large volumes of water is not much of a concern (as it acts as a moderators for neutron flux)}{figure.caption.9}{}}
\newlabel{sub@fig:coolant_fraction}{{a}{16}{Graph of TBR trends againt Coolant fraction for \ce {He(g)}, \ce {N(g)} and \ce {H_2O(l)}. This is a fraction of coolant per volume in the fusion breeder blanket, homogenously spread throughout the blanket as an approximation of real coolant structures. \ce {He(g)} and \ce {N(g)} have very similar trends, as act similar to replacing breeding material with a vacuum. \ce {H_2O(l)} has an interesting trend, in which TBR seems to decrease at a much slower rate against coolant fraction. This indicates that having large volumes of water is not much of a concern (as it acts as a moderators for neutron flux)}{figure.caption.9}{}}
\newlabel{fig:coolant_moderation}{{7b}{16}{Graph of no. of neutrons against energy just before a TBR reaction. This graph confirms that water is indeed acting as a moderator and "trapping" the neutrons with its high scattering cross section. Water therefore can act favourably towards tritium breeding as it can reduce the mean free path the neutrons significantly, and once moderatored TBR reactions have much higher cross section. \ce {He(g)} and \ce {N(g)} still act as vacuums}{figure.caption.9}{}}
\newlabel{sub@fig:coolant_moderation}{{b}{16}{Graph of no. of neutrons against energy just before a TBR reaction. This graph confirms that water is indeed acting as a moderator and "trapping" the neutrons with its high scattering cross section. Water therefore can act favourably towards tritium breeding as it can reduce the mean free path the neutrons significantly, and once moderatored TBR reactions have much higher cross section. \ce {He(g)} and \ce {N(g)} still act as vacuums}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces (a) Demonstrates the effect of having an increasing volume of coolant distributed throughout the breeder blankets. (b) confirms the moderating effect of the water coolant.}}{16}{figure.caption.9}\protected@file@percent }
\newlabel{fig:coolants}{{7}{16}{(a) Demonstrates the effect of having an increasing volume of coolant distributed throughout the breeder blankets. (b) confirms the moderating effect of the water coolant}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Graph showing the how TBR is largely unaffected by the triangularity of the reactor. This is expected for a neutronics study, particularly given that we are assuming a constant neutron ring source, whereas triangularity is a parameter that is significant for plasma physics and density. }}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig:triangularity}{{8}{17}{Graph showing the how TBR is largely unaffected by the triangularity of the reactor. This is expected for a neutronics study, particularly given that we are assuming a constant neutron ring source, whereas triangularity is a parameter that is significant for plasma physics and density}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Graph showing the decreasing trend of TBR against first wall thickness. There are significant neutronic benefits of picking a first wall with lower cross section, with Zirconium leading to the highest TBRs.}}{17}{figure.caption.11}\protected@file@percent }
\newlabel{fig:first_wall}{{9}{17}{Graph showing the decreasing trend of TBR against first wall thickness. There are significant neutronic benefits of picking a first wall with lower cross section, with Zirconium leading to the highest TBRs}{figure.caption.11}{}}
\newlabel{fig:blanket_thickness}{{10a}{18}{Graph Showing Increasing TBR trend against Breeder Blanket Thickness. The benefits of adding thickness diminish almost completely after ~500mm. This indicates that the neutron flux is fully attenuated after the saturation thickness}{figure.caption.12}{}}
\newlabel{sub@fig:blanket_thickness}{{a}{18}{Graph Showing Increasing TBR trend against Breeder Blanket Thickness. The benefits of adding thickness diminish almost completely after ~500mm. This indicates that the neutron flux is fully attenuated after the saturation thickness}{figure.caption.12}{}}
\newlabel{fig:heatmap_slice}{{10b}{18}{This heatmap confirms the attenuation of the neutron flux after the saturation thickness, by indicating almost no TBR reactions after 600mm through the breeder blanket. The Low level of TBR reactions in the first wall is due to its Zirconium Composition, which has a highly endothermic TBR reaction with a very low cross section}{figure.caption.12}{}}
\newlabel{sub@fig:heatmap_slice}{{b}{18}{This heatmap confirms the attenuation of the neutron flux after the saturation thickness, by indicating almost no TBR reactions after 600mm through the breeder blanket. The Low level of TBR reactions in the first wall is due to its Zirconium Composition, which has a highly endothermic TBR reaction with a very low cross section}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces (a) Demonstrates the asymptotic trend of TBR against blanket thickness. (b) confirms neutron attentuation as the physical cause.}}{18}{figure.caption.12}\protected@file@percent }
\newlabel{fig:blanket_thicknesses}{{10}{18}{(a) Demonstrates the asymptotic trend of TBR against blanket thickness. (b) confirms neutron attentuation as the physical cause}{figure.caption.12}{}}
